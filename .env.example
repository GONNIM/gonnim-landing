# Resend (상담 요청 폼 백엔드 · 필수)
# 발급: https://resend.com/api-keys
RESEND_API_KEY=

# 상담 요청 알림 발신·수신 주소 (기본값 hi@gonnim.dev)
CONTACT_FROM_EMAIL=hi@gonnim.dev
CONTACT_TO_EMAIL=hi@gonnim.dev

# 이메일 도메인 MX 실 검증 (선택 · true 로 활성)
# 활성 시 폼 제출 지연 100~300ms · 유령 도메인 배제
CONTACT_VERIFY_MX=

# Upstash Redis · Rate limit (선택 · 없으면 skip)
# https://console.upstash.com — Regional · ap-northeast-1
# 정책: IP 당 5분 3회
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile · 봇 방지 (선택 · 없으면 skip)
# https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_ prefix 는 client 노출용 (그대로 유지)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================
# Sprint Radar (2026-07-13 · Sprint W1)
# ============================================================

# Supabase (필수)
# https://supabase.com/dashboard/project/{project-id}/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 · 절대 클라이언트 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron 인증 (선택 · 로컬 개발 시 비워도 됨)
# Vercel 배포 후 Vercel Dashboard에서 자동 주입되는 CRON_SECRET 활용 권장
CRON_SECRET=

# Radar 관리자 이메일 allow-list (콤마 구분 · 필수 · /api/radar/signup 게이트)
# 미설정 시 signup 503 · 등록된 이메일만 가입/비밀번호 갱신 가능
RADAR_ADMIN_EMAILS=hi@gonnim.dev

# z.ai GLM · Day 4 · /api/radar/generate-draft 지원 초안 자동 생성
# https://z.ai/manage-apikey/apikey-list
# 미설정 시 초안 생성 API 503 · 대시보드 나머지 기능은 정상
ZAI_API_KEY=

# GLM 모델 (선택 · 기본 glm-5.2 · 1M 컨텍스트 · 128K 출력)
# 다른 옵션: glm-4.5 · glm-4.5-air · glm-4.5-flash 등
ZAI_MODEL=

# Base URL 오버라이드 (선택 · 기본 https://api.z.ai/api/paas/v4)
ZAI_BASE_URL=

# ============================================================
# Content Ingest (2026-08-01 · Personal SaaS · /ingest)
# ============================================================

# Groq Whisper API · TikTok/오디오 콘텐츠 스크립트 추출 (STT)
# https://console.groq.com/keys
# 무료 티어 · whisper-large-v3-turbo 사용 (한국어 우수)
# 미설정 시 TikTok 자막 없는 콘텐츠 처리 실패 (503)
GROQ_API_KEY=

# Obsidian Clippings/summaries 저장 경로 (선택 · 로컬 dev 전용)
# 기본값: /Users/gonnim/GON-LLM-Wiki/Clippings/summaries
# Vercel 배포 시 fs 쓰기 불가 → /api/ingest/save 는 로컬 dev 에서만 동작
INGEST_CLIPPINGS_DIR=

# ============================================================
# 지배상식 Dominance (2026-09-25 · /dominance 콘솔)
# ============================================================

# 별도 Supabase 프로젝트 sprint-dominance (D22)
# 지배상식 데이터는 gonnim-landing 프로젝트와 분리해서 둔다.
# 로그인 여부는 위쪽 NEXT_PUBLIC_SUPABASE_* 로 확인하고,
# 이 DB 에는 service_role 로만 닿는다 (RLS 정책을 하나도 만들지 않았다).
DS_SUPABASE_URL=
# 서버 전용 · 절대 클라이언트 노출 금지 · RLS 를 전부 우회한다
DS_SUPABASE_SERVICE_ROLE_KEY=

# 레터 발신자 표기 · Resend 에서 인증이 끝난 도메인이어야 한다
# 비워 두면 "지배상식 <letter@gonnim.dev>" 를 쓴다 (gonnim.dev 는 verified)
# mail.gonnim.dev 는 DNS 기록이 없어 아직 쓸 수 없다 — 인증을 마치면 여기를 바꾼다
DS_FROM_EMAIL=

# 구독자 목록을 담는 Resend 세그먼트 ID · 브로드캐스트 발송 대상
# Resend 는 Audience 를 Segment 로 바꿨고 audienceId 에 폐기 표시를 붙였다
# 없으면 발행 단계만 실패한다 (수집·후보 생성은 그대로 돈다)
# 2026-09-25 생성 · 이름 "지배상식 구독자"
# 7ecaa7d8-4d57-414c-8dc2-0fb1c61e1ddc
DS_RESEND_SEGMENT_ID=

# Cloudflare Pages 배포 훅 (공개 레터 사이트 재빌드 · 크론이 호출)
CF_PAGES_DEPLOY_HOOK=

# 외부 감시 주소 (healthchecks.io) · 크론이 끝날 때마다 여기를 찌른다
# 정상이면 이 주소, 문제가 있으면 뒤에 /fail 을 붙여 찌른다
# 정해진 시간 안에 신호가 없으면 그쪽이 메일을 보낸다 — "크론이 아예 안 돌았다" 를
# 잡는 유일한 수단이다. 크론 안의 경보는 크론이 돌아야 나가기 때문이다
# 비워 두면 찌르지 않는다 (크론은 그대로 돈다)
DS_HEARTBEAT_URL=

# ============================================================
# 로컬 개발: .env.local 에 위 값을 채우면 next dev 자동 로드
# 프로덕션(Vercel): Vercel Dashboard → Project Settings → Environment Variables
